# Crawl / rules
ONPAGE_SEO_USER_AGENT=OnPageSEOBot/1.0 (+https://example.com/bot)
ONPAGE_SEO_REQUEST_TIMEOUT_SEC=20
ONPAGE_SEO_CRAWL_DELAY_SEC=1
ONPAGE_SEO_CRAWL_RETRIES=3
ONPAGE_SEO_RETRY_BACKOFF_SEC=0.5
ONPAGE_SEO_MAX_PAGES=50
ONPAGE_SEO_THRESHOLDS_PATH=config/thresholds.yaml
ONPAGE_SEO_SSRF_GUARD=1

# P1 API + storage
DATABASE_URL=sqlite:///./onpage_seo.db
# DATABASE_URL=postgresql://onpage:onpage@localhost:5432/onpage_seo
ONPAGE_SEO_API_TOKEN=prod-secret-token-change-me

# P2 LLM (100% Free local Ollama, Groq Free Tier, or Gemini Free API)
ONPAGE_SEO_LLM=0

# Option A: 100% Local & Free via Ollama
OPENAI_API_KEY=none
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=llama3.2

# Option B: Groq Free Tier
# OPENAI_API_KEY=gsk_your_free_groq_api_key
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

# Option C: Google Gemini Free Tier
# OPENAI_API_KEY=your_free_gemini_api_key
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-2.5-flash

ONPAGE_SEO_LLM_MAX_CALLS_PER_JOB=20
ONPAGE_SEO_LLM_MAX_TOKENS=800
ONPAGE_SEO_INTERNAL_LINK_MIN_PAGES=3

# P3 Dashboard
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change_this_password
ONPAGE_SEO_REGRESSION_POINTS=5

# P4 CMS auto-fix (default dry-run; never auto-publish without approval)
ONPAGE_SEO_CMS_PROVIDER=wordpress
ONPAGE_SEO_CMS_DRY_RUN=1
WP_BASE_URL=https://example.com
WP_USERNAME=admin
WP_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
